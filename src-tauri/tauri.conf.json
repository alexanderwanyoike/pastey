{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pastey",
  "version": "0.1.0",
  "identifier": "net.jolt.pastey",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5174",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Pastey",
        "width": 1180,
        "height": 780,
        "minWidth": 920,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "icon": ["icons/icon.png"]
  }
}
